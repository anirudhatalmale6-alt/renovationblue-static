# Netlify redirects - Renovation Blue
# Format:  from   to   status
# Docs:    https://docs.netlify.com/routing/redirects/

# ------------------------------------------------------------------------------
# WordPress leftovers
# Anything still pointing at wp-admin / wp-login / feeds now lands on the
# homepage instead of a 404. Search engines are told this is permanent.
# ------------------------------------------------------------------------------
/wp-admin           /   301
/wp-admin/*         /   301
/wp-login.php       /   301
/wp-content/*       /   301
/wp-includes/*      /   301
/xmlrpc.php         /   301
/feed               /   301
/feed/*             /   301
/comments/feed/*    /   301
/?p=:id             /   301
/index.php          /   301

